# ==============================================================================
# Aurelle Spaces - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets, API keys, or production values into version control.
#
# Note on Cloudflare Deployment:
# - In production on Cloudflare Workers, environment secrets (e.g. AUTH_SECRET,
#   GEMINI_API_KEY, RESEND_API_KEY) must be provisioned via `wrangler secret put <KEY>`.
# - Static variables and non-sensitive configurations belong in `wrangler.jsonc` [vars].
# - Cloudflare D1 and R2 resources are bound as platform bindings in `wrangler.jsonc`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Base URLs
# ------------------------------------------------------------------------------
# Local development: http://localhost:3000
# Production: https://aurelle.dsecops88.online
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Authentication & Admin Security (Planned for Prompt 16 & 17)
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens and admin authentication
AUTH_SECRET=your_secure_random_session_secret_min_32_chars
# Optional NextAuth / Auth.js standard URL if used
AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Conversational AI Business Assistant (Planned for Prompt 11)
# ------------------------------------------------------------------------------
# Provider: Google Gemini API (or compatible provider)
GEMINI_API_KEY=your_gemini_api_key_placeholder
AI_MODEL_NAME=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 4. Transactional Email Provider (Planned for Prompt 15)
# ------------------------------------------------------------------------------
# Provider: Resend (or SendGrid/Postmark) for client consultation confirmations
EMAIL_API_KEY=your_resend_api_key_placeholder
EMAIL_FROM_ADDRESS=notifications@aurelle.dsecops88.online
STUDIO_CONTACT_RECIPIENT=studio@aurelle.dsecops88.online

# ------------------------------------------------------------------------------
# 5. n8n Workflow Automation Integration (Planned for Prompt 14)
# ------------------------------------------------------------------------------
# Webhook URL for forwarding enquiries and project leads to self-hosted n8n instance
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/aurelle-enquiry-v1
N8N_WEBHOOK_SECRET=your_n8n_webhook_hmac_secret_placeholder

# ------------------------------------------------------------------------------
# 6. Cloudflare Infrastructure Bindings Reference (Planned for Prompts 12 & 13)
# ------------------------------------------------------------------------------
# In local development with Wrangler or miniflare, these are emulated locally.
# In production, they are bound directly in wrangler.jsonc.
#
# D1 Database binding name: DB
# R2 Media Bucket binding name: MEDIA_BUCKET
# Cloudflare Account ID (only used in CI/CD pipeline or deployment scripts):
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_placeholder

