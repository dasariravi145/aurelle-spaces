# ==============================================================================
# Aurelle Spaces - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets, API keys, or production values into version control.
#
# Production Cloudflare Deployment Strategy:
# - Secrets (e.g. AUTH_SECRET, GEMINI_API_KEY, EMAIL_API_KEY, N8N_WEBHOOK_SECRET)
#   must be provisioned via `npx wrangler secret put <KEY>` for edge workers.
# - Static public variables belong in `wrangler.jsonc` [vars].
# - Cloudflare D1 and R2 resources are bound as platform bindings in `wrangler.jsonc`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Base URLs
# ------------------------------------------------------------------------------
# Local development: http://localhost:3000
# Production: https://aurelle.dsecops88.online
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Authentication & Admin Security
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens and administrative security (min 32 characters)
# Generate via: openssl rand -base64 32
AUTH_SECRET=your_secure_random_session_secret_min_32_chars

# ------------------------------------------------------------------------------
# 3. Conversational AI Studio Concierge
# ------------------------------------------------------------------------------
# Provider: Google Gemini API (or OpenAI-compatible provider)
GEMINI_API_KEY=your_gemini_api_key_placeholder
AI_PROVIDER=google-gemini
AI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Transactional Email Provider
# ------------------------------------------------------------------------------
# Provider: Resend (or SendGrid/Postmark) for client consultation confirmations
EMAIL_API_KEY=your_resend_api_key_placeholder
EMAIL_FROM_ADDRESS=notifications@aurelle.dsecops88.online
STUDIO_CONTACT_RECIPIENT=studio@aurelle.dsecops88.online

# ------------------------------------------------------------------------------
# 5. n8n Workflow Automation Integration
# ------------------------------------------------------------------------------
# Webhook URL for forwarding enquiries and project leads to self-hosted n8n instance
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/aurelle-enquiry-v1
N8N_WEBHOOK_SECRET=your_n8n_webhook_hmac_secret_min_32_chars
N8N_REQUEST_TIMEOUT=10000
AUTOMATION_MAX_RETRIES=5
AUTOMATION_ENABLED=false
CRON_SECRET=your_cron_schedule_secret_for_outbox_trigger

# ------------------------------------------------------------------------------
# 6. Cloudflare R2 Media Storage
# ------------------------------------------------------------------------------
# R2 Storage Bucket: aurelle-media (Binding: MEDIA_BUCKET in wrangler.jsonc)
# Media Public CDN URL: https://media.aurelle.dsecops88.online
NEXT_PUBLIC_MEDIA_URL=https://media.aurelle.dsecops88.online

# ------------------------------------------------------------------------------
# 7. Cloudflare Infrastructure Bindings Reference
# ------------------------------------------------------------------------------
# In local development with Wrangler, these are emulated locally via miniflare.
# In production, they are configured directly in wrangler.jsonc.
#
# D1 Database binding name: DB
# R2 Media Bucket binding name: MEDIA_BUCKET
# Cloudflare Account & API credentials (used only in CI/CD or CLI deployment):
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_placeholder
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_placeholder
