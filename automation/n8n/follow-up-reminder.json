{
  "name": "Aurelle Spaces — Pending Enquiry Follow-up Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 3 * * 1-5"
            }
          ]
        }
      },
      "id": "f1011a00-1122-4433-8899-aabbccddeeff",
      "name": "Schedule: Weekday 09:00 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        180,
        240
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://aurelle.dsecops88.online/api/automations/reminders/pending",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.AUTOMATION_INTEGRATION_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "e2122b11-2233-5544-99aa-bbccddeeff00",
      "name": "Fetch Uncontacted Enquiries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        400,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\nconst candidates = Array.isArray(response.candidates) ? response.candidates : [];\n\nif (candidates.length === 0) {\n  return [];\n}\n\nreturn candidates.map(candidate => ({\n  json: {\n    enquiry_id: candidate.enquiry_id,\n    reference_code: candidate.reference_code,\n    client_name: candidate.client_name,\n    client_email: candidate.client_email,\n    city: candidate.city,\n    project_type: candidate.project_type,\n    status: candidate.status,\n    assigned_admin_name: candidate.assigned_admin_name || 'Studio Team',\n    recipient_email: candidate.recipient_email || 'studio@aurelle.dsecops88.online',\n    created_at: candidate.created_at,\n    hours_uncontacted: candidate.hours_uncontacted || 24,\n    admin_url: candidate.admin_url || `https://aurelle.dsecops88.online/admin/enquiries/${candidate.enquiry_id}`,\n  }\n}));"
      },
      "id": "d3233c22-3344-6655-aabb-ccddeeff0011",
      "name": "Split Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        240
      ]
    },
    {
      "parameters": {
        "fromEmail": "notifications@aurelle.dsecops88.online",
        "toEmail": "={{ $json.recipient_email }}",
        "subject": "Reminder: Enquiry {{ $json.reference_code }} requires initial review ({{ $json.hours_uncontacted }}h uncontacted)",
        "text": "=Hello {{ $json.assigned_admin_name }},\n\nConsultation brief {{ $json.reference_code }} ({{ $json.project_type }}, {{ $json.city }}) has remained in New status for approximately {{ $json.hours_uncontacted }} hours without logged client communication.\n\nClient Name: {{ $json.client_name }}\nSubmitted At: {{ $json.created_at }}\n\nPlease review the requirements and update the triage status:\n{{ $json.admin_url }}\n\n(Aurelle Spaces Automated Follow-Up Policy)",
        "html": "=<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 0 auto; background: #FFFFFF; border: 1px solid #E6DED5; border-radius: 4px; overflow: hidden;\"><div style=\"padding: 24px; background: #1A1615; text-align: center;\"><h2 style=\"margin: 0; color: #FAF8F5; font-weight: 300; letter-spacing: 0.2em; text-transform: uppercase;\">Aurelle Spaces</h2><div style=\"font-size: 11px; color: #A17C55; letter-spacing: 0.15em; text-transform: uppercase; margin-top: 4px;\">Lead Follow-Up Alert</div></div><div style=\"padding: 30px; font-size: 14px; line-height: 1.6; color: #2C2623;\"><h3 style=\"margin-top: 0; color: #1A1615;\">Enquiry Requires Initial Review</h3><p>Hello {{ $json.assigned_admin_name }},</p><p>Consultation brief <strong>{{ $json.reference_code }}</strong> has remained in <em>New</em> status for approximately <strong>{{ $json.hours_uncontacted }} hours</strong> without logged outreach.</p><table style=\"width: 100%; border-collapse: collapse; margin: 20px 0; background: #FAF8F5;\"><tr style=\"border-bottom: 1px solid #EFEAE3;\"><td style=\"padding: 8px 12px; color: #6E6259;\">Reference</td><td style=\"padding: 8px 12px; font-weight: 600;\">{{ $json.reference_code }}</td></tr><tr style=\"border-bottom: 1px solid #EFEAE3;\"><td style=\"padding: 8px 12px; color: #6E6259;\">Client</td><td style=\"padding: 8px 12px;\">{{ $json.client_name }}</td></tr><tr style=\"border-bottom: 1px solid #EFEAE3;\"><td style=\"padding: 8px 12px; color: #6E6259;\">Project Type</td><td style=\"padding: 8px 12px;\">{{ $json.project_type }}</td></tr><tr><td style=\"padding: 8px 12px; color: #6E6259;\">Submitted At</td><td style=\"padding: 8px 12px;\">{{ $json.created_at }}</td></tr></table><div style=\"text-align: center; margin-top: 24px;\"><a href=\"{{ $json.admin_url }}\" style=\"display: inline-block; padding: 12px 24px; background: #1A1615; color: #FAF8F5; text-decoration: none; border-radius: 3px; font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;\">Log Initial Contact</a></div></div></div>",
        "options": {}
      },
      "id": "c4344d33-4455-7766-bbcc-ddeeff001122",
      "name": "Send Follow-up Alert Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        840,
        240
      ]
    },
