          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.AUTOMATION_INTEGRATION_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "enquiry_id",
              "value": "={{ $json.enquiry_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b5455e44-5566-8877-ccdd-eeff00112233",
      "name": "Mark Reminder Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1060,
        240
      ]
    }
  ],
